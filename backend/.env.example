# ================================================================
# 🌾 Smart Mandi Queue Management - Database Configuration
# ================================================================

# 🍃 OPTION 1: MongoDB (Most Beginner-Friendly & Recommended!)
# -------------------------------------------------------------
# A. Free Cloud MongoDB Atlas (Recommended - Works locally and on Vercel):
# MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/smart_mandi?retryWrites=true&w=majority"
#
# B. Local MongoDB (If MongoDB Compass / MongoDB Server is installed on your PC):
# MONGODB_URI="mongodb://127.0.0.1:27017/smart_mandi"

# 🐘 OPTION 2: PostgreSQL / Supabase (Optional)
# -------------------------------------------------------------
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# 📦 OPTION 3: Standalone Local JSON File (Zero Configuration)
# -------------------------------------------------------------
# (Leave MONGODB_URI and DATABASE_URL commented out - it works automatically!)

PORT=5000
